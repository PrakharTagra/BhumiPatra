# BhumiPatra Document Analysis Engine - Environment Configuration

HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Security & Limits
INTERNAL_API_KEY=bhumipatra_internal_secret_key_2026
MAX_FILE_SIZE_MB=50
NODE_BACKEND_URL=http://localhost:5000

# OCR Configuration
OCR_ENGINE=PaddleOCR
OCR_LANGUAGES=hi,en
OCR_USE_GPU=False

# Confidence & Review Thresholds (0.0 to 1.0)
HIGH_CONFIDENCE_THRESHOLD=0.80
REVIEW_THRESHOLD=0.60

# Optional LLM Fallback (Disabled by default - zero hallucination)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
